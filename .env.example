# Do not commit actual values. init-production-env.py generates secure credentials.
DEBUG=0
DJANGO_SECRET_KEY=
# Optional independent random second part, generated by the Render blueprint.
# DJANGO_SECRET_KEY_EXTRA=
POSTGRES_PASSWORD=
ALLOWED_HOSTS=your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
DOMAIN=your-domain.example
TRUST_PROXY=1
STORE_TIME_ZONE=Asia/Amman
# For hosting without Compose, set a PostgreSQL connection URL securely.
# DATABASE_URL=postgresql://user:password@host:5432/database
# SMTP enables forgotten-password email. Configure in your hosting secret settings.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# Managed-host trial only. Leave disabled for the standard Nginx deployment.
# STORE_SETUP_TOKEN=  # Secure random one-time bootstrap token, at least 32 characters
SERVE_PUBLIC_UPLOADS=0
